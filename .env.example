# ---------------------------------------------------------------------------
# Courts After Dark - environment variables
# Copy to .env.local for local development. On Vercel, add the same keys in
# Project -> Settings -> Environment Variables. NEVER commit real values.
# ---------------------------------------------------------------------------

# REQUIRED - MongoDB connection string.
# Production must use a hosted database (e.g. MongoDB Atlas), not 127.0.0.1.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/courts-after-dark

# REQUIRED - secret used to sign/encrypt session JWTs (Auth.js).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# OPTIONAL on Vercel (the request host is trusted automatically).
# Needed only when running behind another proxy / custom host.
AUTH_TRUST_HOST=true

# OPTIONAL - canonical site URL. Not required on Vercel; set it only if you use
# a custom domain behind a proxy, e.g. https://courts.example.com
NEXTAUTH_URL=http://localhost:3000
